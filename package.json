{
	"name": "deployable-knowledge",
	"private": true,
	"version": "1.0.7",
	"description": "Local-first retrieval-augmented generation workbench.",
	"license": "MIT",
	"author": "Deployable Knowledge",
	"type": "module",
	"main": "electron/main.ts",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"predev": "drizzle-kit push --force",
		"dev": "vite dev",
		"build": "vite build",
		"electron": "electron .",
		"electron:pack": "npm run build && electron-builder --dir",
		"electron:win": "npm run build && electron-builder --win",
		"electron:linux": "npm run build && electron-builder --linux",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p electron",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "9.39.2",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "0.5.10",
		"@tailwindcss/typography": "0.5.16",
		"@tailwindcss/vite": "4.3.3",
		"@types/jsdom": "^30.0.0",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^25.9.2",
		"drizzle-kit": "^0.31.11",
		"electron": "^43.7.7",
		"electron-builder": "^26.15.3",
		"esbuild": "^0.28.2",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.19.0",
		"globals": "16.5.0",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "4.1.0",
		"prettier-plugin-tailwindcss": "0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.3.0",
		"@libsql/client": "^0.17.3",
		"@lucide/svelte": "1.25.0",
		"@matbee/libreoffice-converter": "^2.7.2",
		"@tiptap/core": "3.32.0",
		"@tiptap/extension-image": "3.32.0",
		"@tiptap/extension-list": "3.32.0",
		"@tiptap/extension-table": "3.32.0",
		"@tiptap/extension-text-style": "3.32.0",
		"@tiptap/extensions": "3.32.0",
		"@tiptap/markdown": "3.32.0",
		"@tiptap/pm": "3.32.0",
		"@tiptap/starter-kit": "3.32.0",
		"adm-zip": "^0.6.1",
		"bgutils-js": "^4.0.3",
		"bits-ui": "2.18.1",
		"clsx": "2.1.1",
		"dompurify": "^3.4.16",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"exceljs": "^4.4.0",
		"ffmpeg-static": "^5.3.0",
		"jsdom": "^30.0.1",
		"markdown-it": "^14.3.2",
		"node-llama-cpp": "^3.19.1",
		"onnxruntime-node": "^1.30.0",
		"pdf-parse": "^2.4.5",
		"pyodide": "^314.0.2",
		"sharp": "^0.35.5",
		"svelte-sonner": "1.1.1",
		"svelte-streamdown": "^5.0.0",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "3.2.2",
		"tesseract.js": "^7.0.0",
		"tw-animate-css": "1.4.0",
		"youtubei.js": "^18.0.0"
	},
	"overrides": {
		"adm-zip": "^0.6.1",
		"bits-ui": {
			"runed": "^0.38.0",
			"svelte-toolbelt": {
				"runed": "^0.38.0"
			}
		},
		"katex": "^0.19.1",
		"cookie": "^2.0.1",
		"global-agent": "^4.1.3",
		"sharp": "^0.35.5",
		"uuid": "^11.1.1",
		"@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
		"exceljs": {
			"fast-csv": "^5.0.8",
