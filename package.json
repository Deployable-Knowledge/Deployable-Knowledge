		},
		"simple-git": "^4.0.2",
		"@tailwindcss/typography": {
			"postcss-selector-parser": "^7.1.7"
		}
	},
	"allowScripts": {
		"@tailwindcss/oxide@4.3.3": true,
		"electron-winstaller": false,
		"esbuild@0.25.12": true,
		"esbuild@0.28.1": true,
		"esbuild@0.28.2": true,
		"ffmpeg-static@5.3.0": true,
		"node-llama-cpp@3.22.2": true,
		"onnxruntime-node@1.30.0": true,
		"protobufjs@7.6.6": true,
		"tesseract.js@7.0.0": true
	}
}
